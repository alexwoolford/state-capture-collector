<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.woolford.state-capture-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>exec "$HOME/state-capture-collector/scripts/pull.sh"</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ORACLE_SSH</key>
    <string>ct-firehose</string>
    <key>DATABASE_URL</key>
    <string>postgres://localhost/mosaic</string>
  </dict>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/state-capture-pull.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/state-capture-pull.err</string>
</dict>
</plist>
