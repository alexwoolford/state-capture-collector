[Unit]
Description=State capture collector (drain _outbox to spool)
Documentation=file:///opt/state-capture-collector/docs/DAILY_OPS.md
Requires=state-capture-collect.socket
After=state-capture-collect.socket

[Service]
Type=simple
Restart=always
RestartSec=2
Nice=10
EnvironmentFile=-/opt/state-capture-collector/etc/state-capture.env
ExecStart=/opt/state-capture-collector/bin/state-capture collect --tick-secs 60
SyslogIdentifier=state-capture-collect
# Root: prune _outbox in work sqlite named by announce JSON.
# Extra /var/lib trees are host inventory: a systemd drop-in, not this unit.
ReadWritePaths=/var/lib/state-capture
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
